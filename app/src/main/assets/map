<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Подключаем стили и библиотеку с CDN (весит 0 КБ в вашем APK) -->
    <link href="https://unpkg.com/maplibre-gl@^3.0.0/dist/maplibre-gl.css" rel="stylesheet" />
    <script src="https://unpkg.com/maplibre-gl@^3.0.0/dist/maplibre-gl.js"></script>
    <style>
        body { margin: 0; padding: 0; }
        #map { position: absolute; top: 0; bottom: 0; width: 100%; }
    </style>
</head>
<body>
    <div id="map"></div>
    <script>
        maplibregl.accessToken = 'ВАШ_ТОКЕН_MAPLIBRE_ИЛИ_СТИЛЬ'; // Если нужен ключ
        const map = new maplibregl.Map({
            container: 'map',
            style: 'https://demotiles.maplibre.org/style.json', // Бесплатный стиль
            center: [37.6173, 55.7558], // Москва по умолчанию
            zoom: 9
        });

        map.addControl(new maplibregl.NavigationControl(), 'top-left');

        // Функция для получения геолокации через GPS браузера
        map.on('load', function() {
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(function(position) {
                    const userLocation = [position.coords.longitude, position.coords.latitude];
                    map.setCenter(userLocation);
                    map.setZoom(14);
                    // Добавляем маркер
                    new maplibregl.Marker().setLngLat(userLocation).addTo(map);
                });
            }
        });
    </script>
</body>
</html>