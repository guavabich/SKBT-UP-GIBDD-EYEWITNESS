<?xml version="1.0" encoding="utf-8"?>

<selector
    xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">

        <shape>

            <solid
                android:color="#DDE8FF" />

            <corners
                android:radius="14dp" />

        </shape>

    </item>

    <item>

        <shape>

            <solid
                android:color="#EEF3FF" />

            <corners
                android:radius="14dp" />

            <stroke
                android:width="1dp"
                android:color="#D9E3F5" />

        </shape>

    </item>

</selector>